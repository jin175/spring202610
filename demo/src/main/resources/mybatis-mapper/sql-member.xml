<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.MemberMapper"> 
	<select id="selectMemberList" parameterType="hashmap" resultType="com.example.demo.model.Member">
		SELECT *
		FROM MEMBER
	</select>
	
	<select id="selectMember" parameterType="hashmap" resultType="com.example.demo.model.Member">
		SELECT *
		FROM MEMBER
		WHERE MEMBER_ID = #{memberId}
	</select>
	
	<insert id="insertMember" parameterType="hashmap">
		INSERT INTO MEMBER(MEMBER_ID, PASSWORD, MEMBER_NAME)
		VALUES(#{memberId}, #{pwd}, #{memberName})
	</insert>
	
	<delete id="deleteMember" parameterType="hashmap">
		DELETE FROM MEMBER
		WHERE MEMBER_ID = #{memberId}
	</delete>
	
	<update id="updateMember">
		UPDATE MEMBER SET
			MEMBER_NAME = #{memberName}
		WHERE MEMBER_ID = #{memberId}
	
	</update>


</mapper>